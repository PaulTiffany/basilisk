{
  "version": "0.2.0-dev",
  "kind": "mechanical_exemplar",
  "exemplar_id": "producer-witness-authority-separation",
  "derived_from_seed": "producer-witness-authority",
  "source_note": "Human-supplied constitutional seed: production and self-checking are evidence channels, not acceptance authority. Witnessing and authority remain separate, inspectable channels. Acceptance authority is human-rooted; model or mechanical ratification cannot self-promote into human authorization.",
  "rule": "production does not confer authority",
  "channels": {
    "producer": "model",
    "witness": "independent",
    "authority": "human"
  },
  "cases": [
    {
      "id": "self-certified-no-witness",
      "produced": true,
      "producer_self_check": true,
      "independent_witness": false,
      "disposition": "ratify",
      "expected_gate": "checkpoint",
      "authority_channel": "human",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "self-check-off-defer",
      "produced": true,
      "producer_self_check": false,
      "independent_witness": true,
      "disposition": "defer",
      "expected_gate": "checkpoint",
      "authority_channel": "human",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "self-check-on-defer",
      "produced": true,
      "producer_self_check": true,
      "independent_witness": true,
      "disposition": "defer",
      "expected_gate": "checkpoint",
      "authority_channel": "human",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "witnessed-veto",
      "produced": true,
      "producer_self_check": true,
      "independent_witness": true,
      "disposition": "veto",
      "expected_gate": "stop",
      "authority_channel": "human",
      "derived_gate": "stop",
      "matches_expected": true
    },
    {
      "id": "witnessed-modify",
      "produced": true,
      "producer_self_check": true,
      "independent_witness": true,
      "disposition": "modify",
      "expected_gate": "checkpoint",
      "successor_id": "candidate-2",
      "authority_channel": "human",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "witnessed-model-ratify",
      "produced": true,
      "producer_self_check": false,
      "independent_witness": true,
      "authority_channel": "model",
      "disposition": "ratify",
      "expected_gate": "checkpoint",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "witnessed-mechanical-ratify",
      "produced": true,
      "producer_self_check": false,
      "independent_witness": true,
      "authority_channel": "mechanical",
      "disposition": "ratify",
      "expected_gate": "checkpoint",
      "derived_gate": "checkpoint",
      "matches_expected": true
    },
    {
      "id": "witnessed-ratify",
      "produced": true,
      "producer_self_check": false,
      "independent_witness": true,
      "disposition": "ratify",
      "expected_gate": "proceed_and_report",
      "authority_channel": "human",
      "derived_gate": "proceed_and_report",
      "matches_expected": true
    }
  ],
  "mechanical_witness": {
    "all_cases_match_expected": true,
    "producer_self_check_is_not_acceptance_authority": true,
    "witness_and_authority_are_distinct_inputs": true,
    "nonhuman_ratification_is_not_acceptance_authority": true
  },
  "minimal_pair": {
    "invariant": "Changing only producer self-check does not change acceptance authority.",
    "left": {
      "case": "self-check-off-defer",
      "gate": "checkpoint"
    },
    "right": {
      "case": "self-check-on-defer",
      "gate": "checkpoint"
    }
  },
  "certificate_scope": {
    "certifies": [
      "The committed exemplar is deterministically derived from the committed seed and fixed finite acceptance law.",
      "Producer self-check alone cannot change the modeled acceptance gate.",
      "A witnessed veto remains stop and a witnessed modification remains checkpointed.",
      "Witness plus human ratification releases the modeled candidate to proceed_and_report.",
      "Model or mechanical ratification does not confer acceptance authority."
    ],
    "does_not_certify": [
      "That a real witness channel is operationally independent.",
      "That a human or other authority holder is infallible.",
      "That a model is a box or that an authority boundary is an impermeable wall.",
      "That evidence, capability, verification, or production automatically grants operational authority."
    ]
  }
}
