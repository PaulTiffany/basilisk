      "mutation": {"operator":"remove_edge","edge":["x","child"]},
      "target_vertex": "child",
      "expected": {"target_before":true,"target_after":false}
    },
    {
      "id": "add_coparent",
      "vertices": ["x","parent","child","coparent"],
      "distinguished": "x",
      "before_edges": [["x","child"]],
