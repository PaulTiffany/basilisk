      "mutation": {"operator":"remove_edge","edge":["parent","x"]},
      "target_vertex": "parent",
      "expected": {"target_before":true,"target_after":false}
    },
    {
      "id": "add_child",
      "vertices": ["x","parent","child","coparent"],
      "distinguished": "x",
