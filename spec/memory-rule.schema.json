{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/map-lb/memory-rule.schema.json",
  "title": "MAP-LB Scoped Memory Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "scope",
    "text",
    "kind",
    "source"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
