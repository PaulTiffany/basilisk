{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/map-lb/action-intent.schema.json",
  "title": "MAP-LB Action Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "action_class",
    "description"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "action_class": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "within_contract": {
      "type": "boolean",
      "default": true
    },
    "hard_boundary_violation": {
      "type": "boolean",
      "default": false
    },
    "current_turn_explicit_authorization": {
      "type": "boolean",
      "default": false
    },
    "reversible": {
      "type": "boolean",
      "default": true
    },
    "rollback_available": {
      "type": "boolean",
      "default": true
    },
    "inspectable": {
      "type": "boolean",
      "default": true
    },
    "material_change": {
      "type": "boolean",
      "default": false
    },
    "affects_external_system": {
      "type": "boolean",
      "default": false
    },
    "audience_change": {
      "type": "boolean",
      "default": false
    },
    "privacy_change": {
      "type": "boolean",
      "default": false
    },
    "authority_expansion": {
      "type": "boolean",
      "default": false
    },
    "scope": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "uncertainty": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "judgment_mode": {
      "enum": [
        "none",
        "user_supplied",
        "sourced_external",
        "explicit_model_recommendation",
        "narrow_safety"
      ],
      "default": "none"
    },
    "judgment_requested": {
      "type": "boolean",
      "default": false
    },
    "concrete_immediate_safety_risk": {
      "type": "boolean",
      "default": false
    },
    "destructive": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
